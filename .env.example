# =============================================================================
# BeeBop environment variables — copy to .env.local (not committed)
# =============================================================================

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/beebop
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development
LISTING_DOCUMENT_REVIEW_REQUIRED=false

# --- External Services ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=beebopng@gmail.com

WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=beebop_otp

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# NIMC_API_KEY=
# NIMC_API_URL=
# CAC_API_KEY=
# CAC_API_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

GOOGLE_MAPS_API_KEY=

# --- Media storage (Cloudinary for MVP) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Document/inspector evidence (S3 or compatible) ---
S3_BUCKET=beebop-documents
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Production first-admin bootstrap ---
# Optional: set these on the backend service once, deploy/restart, then log in
# with this email via OTP at /login.
ADMIN_BOOTSTRAP_EMAIL=beebopng@gmail.com
ADMIN_BOOTSTRAP_FIRST_NAME=BeeBop
ADMIN_BOOTSTRAP_LAST_NAME=Admin
ADMIN_BOOTSTRAP_PASSWORD=Mfgvbuay79a@Ww016

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_* variables are exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side proxy target for /api/backend/* when NEXT_PUBLIC_API_URL is absent
# or accidentally points at the frontend domain in production.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_API_KEY=
